{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "TestTool",
          "rules": [
            {
              "id": "SQL001",
              "defaultConfiguration": {
                "level": "error"
              }
            }
          ]
        }
      },
      "invocations": [
        {
          "executionSuccessful": true,
          "ruleConfigurationOverrides": [
            {
              "descriptor": {
                "id": "SQL001"
              },
              "configuration": {
                "level": "warning"
              }
            }
          ]
        }
      ],
      "results": [
        {
          "ruleId": "SQL001",
          "provenance": {
            "invocationIndex": 0
          },
          "message": {
            "text": "Override for SQL001 sets level to warning, overriding rule default of error."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/db.py"
                },
                "region": {
                  "startLine": 42
                }
              }
            }
          ]
        }
      ]
    }
  ]
}