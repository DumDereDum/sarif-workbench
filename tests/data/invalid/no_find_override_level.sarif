          "message": { "text": "invocationIndex is valid, but no override matches SQL001 — code does NOT fall back to rule.default_level (error) here, it falls through the for-loop with level still None and lands on the final 'warning' fallback. This is the key implementation-specific edge case, distinct from a naive reading of the spec." },
          "locations": [
            { "physicalLocation": { "artifactLocation": { "uri": "src/db.py" }, "region": { "startLine": 42 } } }
